# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real ".env" file — it's already in .gitignore.

# Your MongoDB Atlas connection string, with a NEW password
# (rotate the old one in Atlas before using this app again).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>

PORT=8000
